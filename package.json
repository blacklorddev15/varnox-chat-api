{
  "name": "varnox-chat-api",
  "version": "1.0.0",
  "private": true,
  "description": "Varnox Chat API - tRPC over Express, with a Server-Sent Events channel for realtime delivery.",
  "main": "server-dist/index.mjs",
  "scripts": {
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outfile=server-dist/index.mjs",
    "start": "NODE_ENV=production node server-dist/index.mjs",
    "dev": "tsx watch server/_core/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
  "dependencies": {
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "pg": "^8.23.0",
    "superjson": "^1.13.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
