# Copy to .env for local development. On Render these are set in the dashboard or render.yaml.

# Port to listen on. Render sets this automatically; Pterodactyl uses SERVER_PORT instead.
PORT=3000

NODE_ENV=development

# PostgreSQL. Migrations run against this too.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Signs session tokens. Use a long random string; changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-secret

# The first/admin account, by username.
OWNER_OPEN_ID=blacklorddev

# Outbound email (verification codes, password resets).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=Varnox Chat <no-reply@your-domain.com>

# Optional: SMS delivery for phone verification. Without these, codes are logged instead.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_BRAND=
